  "grammarPoints": [
    {"id": "01", "form": "~ません", "meaning": "~하지 않습니다", "connect": "동사 ます형 + ません",
     "examples": [
       {"jp": "がっこうにはまいにちいきません。", "ko": "학교는 매일 가지 않습니다."},
       {"jp": "あさごはんをたべません。", "ko": "아침밥을 먹지 않습니다."}
     ]},
    {"id": "02", "form": "~ませんか", "meaning": "~하지 않겠습니까? (권유)", "connect": "동사 ます형 + ませんか",
     "examples": [
       {"jp": "いっしょにうたをうたいませんか。", "ko": "함께 노래를 부르지 않겠습니까?"},
       {"jp": "スキーをならいませんか。", "ko": "스키를 배우지 않을래요?"}
     ]},
    {"id": "03", "form": "~ましょう", "meaning": "~합시다 (권유·제안)", "connect": "동사 ます형 + ましょう",
     "examples": [
       {"jp": "もくようびにあいましょう。", "ko": "목요일에 만납시다."},
       {"jp": "ドアをあけましょうか。", "ko": "문을 열까요?"}
     ]},
    {"id": "04", "form": "~にいく / ~にくる", "meaning": "~하러 가다 / ~하러 오다", "connect": "동사 ます형 + にいく / にくる",
     "examples": [
       {"jp": "にちようび、かぞくとはなみにいきます。", "ko": "일요일에 가족과 꽃구경하러 갑니다."},
       {"jp": "ともだちがあいにきます。", "ko": "친구가 만나러 옵니다."}
     ]},
    {"id": "05", "form": "~たい", "meaning": "~하고 싶다 (1·2인칭 희망)", "connect": "동사 ます형 + たい",
     "examples": [
       {"jp": "アメリカにいきたい。", "ko": "미국에 가고 싶다."},
       {"jp": "にほんりょうりがたべたいです。", "ko": "일본요리를 먹고 싶습니다."}
     ]},
    {"id": "06", "form": "~ないでください", "meaning": "~하지 마세요 (금지·부탁)", "connect": "동사 ない형 + でください",
     "examples": [
       {"jp": "しつないではたばこをすわないでください。", "ko": "실내에서는 담배를 피우지 마세요."},
       {"jp": "あしたはこないでください。", "ko": "내일은 오지 마세요."}
     ]},
    {"id": "07", "form": "~ないほうがいい", "meaning": "~하지 않는 편이 좋다 (충고)", "connect": "동사 ない형 + ほうがいい",
     "examples": [
       {"jp": "おさけはのまないほうがいいです。", "ko": "술은 마시지 않는 편이 좋습니다."},
       {"jp": "あまいのはたくさんたべないほうがいいです。", "ko": "단 것은 많이 먹지 않는 편이 좋습니다."}
     ]},
    {"id": "08", "form": "~なければならない", "meaning": "~하지 않으면 안 된다 / ~해야 한다", "connect": "동사 ない형(なく 부분을 なければ로) + ならない",
     "examples": [
       {"jp": "こうつうルールはまもらなければならない。", "ko": "교통규칙은 지키지 않으면 안 된다."},
       {"jp": "まいにちくすりをのまなければならない。", "ko": "매일 약을 먹지 않으면 안 된다."}
     ]},
    {"id": "09", "form": "~なくてもいい", "meaning": "~하지 않아도 된다 (허용)", "connect": "동사 ない형 + なくてもいい",
     "examples": [
       {"jp": "かれとはあわなくてもいいです。", "ko": "그와는 만나지 않아도 됩니다."},
       {"jp": "ねだんはそんなにたかくなくてもいいです。", "ko": "가격은 그렇게 비싸지 않아도 됩니다."}
     ]}
  ],

